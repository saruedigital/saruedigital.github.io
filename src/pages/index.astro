---
import i18n from "../assets/i18n/pt-br.json";
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const indexPost = await getEntry("blog", "boas-vindas-a-um-sarue-digital")
const { Content } = await render(indexPost?.data);
---
<Layout title={i18n.pages.index.title}>
    <Content />
</Layout>
