---
import { getCollection } from "astro:content";
import i18n from "../assets/i18n/pt-br.json";
import Layout from "../layouts/Layout.astro";

const posts = await getCollection("blog")
---
<Layout title={i18n.pages.index.title}>
  <div slot="content">
    {posts?.map(post => (
      <div class="border-2 p-6 rounded-xl border-">
        <h1 class="font-semibold">
          {post?.data?.title}
        </h1>
        <h2 class="font-light">
          {post?.data?.description}
        </h2>
      </div>
    ))}
  </div>
</Layout>
