---
import { getCollection } from 'astro:content'
import i18n from '../assets/i18n/pt-br.json'

const posts = await getCollection("blog")
---

<div>
  <h2>{i18n.layout.sidebar.articles}</h2>

  <ul>
    {posts?.map(post => <li>
      <a href={`/posts/${post.id}`}>
        <span class="font-light">
          {post.data.title}
        </span>
      </a>
    </li>)}
  </ul>
</div>
